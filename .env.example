# ---------------------------------------------------------------------------
# 复制为 .env 后填入自己的值：  cp .env.example .env
# .env 已被 .gitignore 忽略，绝不会进仓库。
# ---------------------------------------------------------------------------

# 高德「Web 服务」key —— 城市名 → 经纬度（地理编码），再据此请求天气。
# 申请：https://console.amap.com/dev/key/app  → 新建 Key → 服务平台选「Web服务」
# 读取方：app.config.js（注入到 Constants.expoConfig.extra.amapApiKey）
AMAP_WEB_KEY=your_amap_web_service_key

# ---------------------------------------------------------------------------
# 另外还需要一个高德「Android 平台」key（原生定位 SDK 用，绑定包名 + 签名 SHA1）。
# 这个 key 不经过 .env，由 android/app/build.gradle 直接从下面任一来源读取：
#
#   1) android/local.properties     （推荐，本地构建；该文件已被 .gitignore 忽略）
#        AMAP_API_KEY=你的Android平台key
#   2) 环境变量 AMAP_API_KEY        （EAS Build 用这个）
#   3) ~/.gradle/gradle.properties
#
# 读取方：AndroidManifest.xml 的 com.amap.api.v2.apikey（占位符 ${amapApiKey}）
# ---------------------------------------------------------------------------
